#!/usr/bin/env sh
set -eu

export CGO_ENABLED="${CGO_ENABLED:-0}"
export GOCACHE="${GOCACHE:-/tmp/mogent-gocache}"
export GOMODCACHE="${GOMODCACHE:-/tmp/mogent-gopath/pkg/mod}"

go test ./...
go vet ./...

if ! command -v errcheck >/dev/null 2>&1; then
  echo "tools/check: errcheck is required; run through 'nix develop -c tools/check' or install errcheck" >&2
  exit 1
fi

errcheck ./...
go build -o /tmp/mogent ./cmd/mogent
git diff --check
